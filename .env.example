# Único lugar com segredos: copie para .env (ignorado pelo git) e troque todos os CHANGE_ME.
# cp .env.example .env

# MySQL. Gere cada senha com: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME
# Senha do usuário da aplicação (neoparking_app).
MYSQL_PASSWORD=CHANGE_ME

# JWT: pelo menos 32 bytes. Gere com: openssl rand -hex 32
Jwt__Secret=CHANGE_ME

# Documento, nome e telefone de clientes. Duas chaves diferentes, cada uma com: openssl rand -hex 32
# Guarde uma cópia fora do banco e do backup dele: sem elas, esses dados ficam irrecuperáveis.
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME
DOCUMENT_HMAC_KEY=CHANGE_ME
# Só durante a rotação da chave de cifra (veja o README): a versão da chave atual e as anteriores, como versão:chave.
# DOCUMENT_ENCRYPTION_KEY_VERSION=2
# DOCUMENT_ENCRYPTION_PREVIOUS_KEYS=1:CHANGE_ME

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Só com docker-compose.expose-db.yml
# MYSQL_EXPOSED_PORT=3306
