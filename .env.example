# Copie este arquivo para .env e troque todos os valores CHANGE_ME.
# cp .env.example .env
# As senhas ficam dentro de connection strings: não use ";" nelas.

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_APP_PASSWORD=CHANGE_ME_app_password

# JWT: pelo menos 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_random_value

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Só com docker-compose.expose-db.yml
# MYSQL_EXPOSED_PORT=3306
